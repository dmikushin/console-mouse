#!/usr/bin/python3
"""Mouse on the Linux text console, including wheel scrolling in tmux.

gpm never forwards the wheel to programs, and the kernel's own mouse report
(TIOCL_SELMOUSEREPORT) can encode buttons 0-15 only, while the xterm wheel
codes are 64/65. This daemon reads the pointing devices (mice, TrackPoint,
touchpad) and the keyboards through evdev and, while the foreground VT is in
text mode (KD_TEXT, i.e. not X):

  * draws the pointer (TIOCL_SELPOINTER);
  * selects with the left button, whatever the program asked for, as a
    graphical terminal does: drag selects, double click words, triple click
    lines, highlighted by the kernel (TIOCL_SETSEL). The kernel drops the
    highlight on any write to the console; while the selected cells still
    hold the selected text, the daemon puts it back;
  * if the program on the console asked for mouse reports (DECSET 9/1000,
    read back with TIOCL_GETMOUSEREPORTING), injects xterm X10-encoded
    reports into the tty input with TIOCSTI: a left click that did not move
    (press and release, sent on release), the right button and the wheel -
    what tmux "set -g mouse on" understands. Shift held hands the left
    button to the program, drag included (tmux pane borders, mc);
    without reporting, a right click extends the selection;
  * Ctrl+Shift+C, Alt+C, Ctrl+Alt+C or Ctrl+Insert copies the selection,
    Ctrl+Shift+V, Alt+V, Ctrl+Alt+V or Shift+Insert pastes it (bracketed if
    the program enabled DECSET 2004). These chords are voided in the console
    keymap so the program does not also get ^C, ^V, ESC c, ESC v, ESC ^C,
    ESC ^V or Insert;
  * a middle click toggles nerd-dictation (its daemon's socket), as the
    middle button does under X; the middle button is not passed on.

Wheel sources: a mouse wheel; TrackPoint moved with the middle button held;
two fingers on the touchpad. Touchpad taps click like libinput's defaults:
one finger left, two fingers right; a two-finger touchpad press is a right
click.

A touchscreen works directly: a tap clicks the touched cell (two-finger tap:
right click), one finger dragged drags with the left button (selects), two
fingers dragged scroll, moving the content with the fingers.
"""
import fcntl
import glob
import math
import os
import pwd
import select
import signal
import struct
import subprocess
import sys
import time
import traceback

EVENT = struct.Struct("llHHi")
EV_SYN, EV_KEY, EV_REL, EV_ABS = 0x00, 0x01, 0x02, 0x03
SYN_REPORT = 0
REL_X, REL_Y, REL_WHEEL = 0x00, 0x01, 0x08
ABS_X, ABS_Y = 0x00, 0x01
ABS_MT_SLOT, ABS_MT_POSITION_X, ABS_MT_POSITION_Y = 0x2F, 0x35, 0x36
ABS_MT_TRACKING_ID = 0x39
BTN_LEFT, BTN_RIGHT, BTN_MIDDLE = 0x110, 0x111, 0x112
BTN_TOOL_FINGER, BTN_TOUCH = 0x145, 0x14A
BTN_TOOL_DOUBLETAP, BTN_TOOL_TRIPLETAP, BTN_TOOL_QUADTAP = 0x14D, 0x14E, 0x14F
INPUT_PROP_POINTER, INPUT_PROP_DIRECT, INPUT_PROP_BUTTONPAD = 0x00, 0x01, 0x02
KEY_LEFTCTRL, KEY_RIGHTCTRL = 29, 97
KEY_LEFTSHIFT, KEY_RIGHTSHIFT = 42, 54
KEY_LEFTALT = 56
KEY_C, KEY_V = 46, 47
KEY_INSERT = 110
CTRL, SHIFT = {KEY_LEFTCTRL, KEY_RIGHTCTRL}, {KEY_LEFTSHIFT, KEY_RIGHTSHIFT}

EVIOCGBIT = lambda ev, size: 0x80004520 | (size << 16) | ev
EVIOCGPROP = 0x80044509
EVIOCGABS = lambda axis: 0x80184540 + axis
KDGETMODE, KD_TEXT = 0x4B3B, 0x00
# Keyboard modes in which a program reads characters (TIOCSTI input is text).
# In K_RAW / K_MEDIUMRAW it reads scancodes or keycodes itself (a screen lock
# such as ttysecurelock does): injected bytes would be taken as keys, so the
# daemon leaves such a VT alone, as it leaves X alone.
KDGKBMODE, K_XLATE, K_UNICODE = 0x4B44, 0x01, 0x03
KDGKBENT, KDSKBENT = 0x4B46, 0x4B47
TIOCLINUX, TIOCSTI, TIOCGWINSZ = 0x541C, 0x5412, 0x5413
TIOCL_SETSEL, TIOCL_GETMOUSEREPORTING, TIOCL_GETBRACKETEDPASTE = 2, 7, 18
SEL_CHAR, SEL_WORD, SEL_LINE, SEL_POINTER, SEL_CLEAR = 0, 1, 2, 3, 4

# Keymap entries voided, as (table, keycode); tables are modifier bit sets:
# shift 1, altgr 2, control 4, alt 8. AltGr is the Cyrillic lock of
# ruwin_cplk. Ctrl+Shift+C/V, Alt+C/V, Ctrl+Alt+C/V, Shift+Insert,
# Ctrl+Insert.
K_HOLE = 0x0200
VOIDED = tuple((t, k) for t in (4 | 1, 4 | 1 | 2, 8, 8 | 2, 4 | 8, 4 | 8 | 2)
               for k in (KEY_C, KEY_V)) + \
    tuple((t, KEY_INSERT) for t in (1, 1 | 2, 4, 4 | 2))
# The voided entries as they were before any instance changed them. In
# /run: the kernel keymap does not survive a reboot either.
KEYMAP_STATE = "/run/console-mouse/keymap-original"

# Pointer speed in character cells.
REL_COLS_PER_COUNT, REL_ROWS_PER_COUNT = 1 / 8, 1 / 16
TP_COLS_PER_MM, TP_ROWS_PER_MM = 1.4, 0.7
# Distance per emitted wheel step.
REL_SCROLL_COUNTS = 12          # TrackPoint with the middle button held
TP_SCROLL_MM = 3.0              # two fingers on the touchpad
MULTI_CLICK_SECONDS = 0.4
# A touch shorter and stiller than this is a tap (libinput: 180 ms, 1.3 mm).
TAP_SECONDS = 0.18
TAP_MAX_MM = 1.3
# Touchscreen: a touch shorter than this that stays within TS_TAP_CELLS of
# where it began is a tap; two fingers moved by TS_SCROLL_ROWS rows make one
# wheel step.
TS_TAP_SECONDS = 0.25
TS_TAP_CELLS = 1.0
TS_SCROLL_ROWS = 2.0
RESCAN_SECONDS = 5
XTERM_MAX_CELL = 223            # X10 encoding limit: 32 + cell <= 255
DICTATION_SOCKET = "/run/user/{uid}/nerd-dictation-ex.sock"

BUTTON_CODE = {BTN_LEFT: 0, BTN_MIDDLE: 1, BTN_RIGHT: 2}
WHEEL_UP, WHEEL_DOWN, RELEASE = 64, 65, 3
MOTION = 32                     # xterm: added to a button code for motion


def log(*args):
    print(*args, flush=True)


def bit(bits, n):
    return bits[n // 8] >> (n % 8) & 1


class Device:
    def __init__(self, fd, path, pointer=None, keyboard=False, res=(1, 1)):
        self.fd, self.path = fd, path
        self.pointer = pointer          # None, "rel", "touchpad", "touchscreen"
        self.keyboard = keyboard
        self.res_x, self.res_y = res[0] or 1, res[1] or 1
        # Clickpad (the whole pad is one button): the software button area,
        # as libinput draws it - a strip at the bottom, 10 mm or 15 % of
        # the height whichever is smaller, whose right half is the right
        # button. (top edge, left edge of the right button) in device units.
        self.right_area = None
        self.reset_frame()
        # Touchpad tracking.
        self.abs_x = self.abs_y = None
        self.last_x = self.last_y = None
        self.touching = False
        self.fingers = 0
        self.touch_start = 0.0
        self.tap_fingers = 0        # most fingers seen during this touch
        self.tap_travel = 0.0       # mm moved during this touch
        self.tap_clicked = False    # the pad was pressed: not a tap
        self.pressed_as = {}        # evdev button -> button it acted as
        # Middle button: scrolls while moved (TrackPoint), clicks when still.
        self.middle_down = False
        self.middle_moved = False
        self.scroll_acc = 0.0
        # Touchscreen: absolute ranges, contacts by MT slot, gesture state.
        self.ranges = None              # ((min_x, max_x), (min_y, max_y))
        self.slot = 0
        self.contacts = set()           # slots with a finger on the screen
        # Last position per slot. The kernel does not resend an unchanged
        # value, so a new contact in a slot may arrive without a position.
        self.slot_pos = {}              # slot -> [x, y]
        self.slot_prev = {}             # touchpad: slot positions last frame
        self.gesture = None

    def reset_frame(self):
        self.dx = self.dy = 0
        self.wheel = 0
        self.keys = []


def probe(path):
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        key, rel, abs_, prop = (bytearray(96), bytearray(8), bytearray(8),
                                bytearray(4))
        fcntl.ioctl(fd, EVIOCGBIT(EV_KEY, len(key)), key)
        fcntl.ioctl(fd, EVIOCGBIT(EV_REL, len(rel)), rel)
        fcntl.ioctl(fd, EVIOCGBIT(EV_ABS, len(abs_)), abs_)
        fcntl.ioctl(fd, EVIOCGPROP, prop)
        keyboard = bool(bit(key, KEY_C) and bit(key, KEY_LEFTCTRL))
        if bit(rel, REL_X) and bit(rel, REL_Y) and bit(key, BTN_LEFT):
            return Device(fd, path, pointer="rel", keyboard=keyboard)
        if (bit(abs_, ABS_MT_POSITION_X) and bit(abs_, ABS_MT_POSITION_Y)
                and bit(abs_, ABS_MT_TRACKING_ID) and bit(prop, INPUT_PROP_DIRECT)):
            dev = Device(fd, path, pointer="touchscreen", keyboard=keyboard)
            ranges = []
            for axis in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                info = bytearray(24)
                fcntl.ioctl(fd, EVIOCGABS(axis), info)
                ranges.append(struct.unpack("6i", info)[1:3])
            dev.ranges = tuple(ranges)
            return dev
        if (bit(abs_, ABS_X) and bit(abs_, ABS_Y)
                and bit(key, BTN_TOOL_FINGER) and bit(prop, INPUT_PROP_POINTER)):
            res, ranges = [], []
            for axis in (ABS_X, ABS_Y):
                info = bytearray(24)
                fcntl.ioctl(fd, EVIOCGABS(axis), info)
                _, lo, hi, _, _, r = struct.unpack("6i", info)
                res.append(r)
                ranges.append((lo, hi))
            dev = Device(fd, path, pointer="touchpad", keyboard=keyboard,
                         res=res)
            if bit(prop, INPUT_PROP_BUTTONPAD):
                (x0, x1), (y0, y1) = ranges
                height_mm = (y1 - y0) / dev.res_y
                strip_mm = min(10.0, height_mm * 0.15)
                dev.right_area = (y1 - strip_mm * dev.res_y, x0 + (x1 - x0) / 2)
            return dev
        if keyboard:
            return Device(fd, path, keyboard=True)
    except OSError:
        pass
    os.close(fd)
    return None


KDGKBMODE, K_UNICODE = 0x4B44, 0x03
VT_GETSTATE = 0x5603


def unicode_vt():
    """An fd of an allocated VT whose keyboard is in Unicode mode, or None.

    The keymap is global, but KDGKBENT/KDSKBENT convert entries by the
    keyboard mode of the VT they are issued on: through a VT that is not in
    Unicode mode (X's VT, a raw-mode lock VT) Unicode entries read as
    K_HOLE and writing one fails with EINVAL (measured). /dev/tty0 is
    whatever VT is in front, so reading "original" entries through it while
    X is in front would record holes, and restoring them would write the
    holes over real keys. Candidates: the VT in front, then the allocated
    VTs 1-15 (VT_GETSTATE; opening an unallocated VT would allocate it)."""
    with open("/sys/class/tty/tty0/active") as f:
        front = int(f.read().strip()[3:])
    fd = os.open("/dev/tty0", os.O_RDONLY | os.O_NOCTTY)
    try:
        state = bytearray(6)
        fcntl.ioctl(fd, VT_GETSTATE, state)
        in_use = struct.unpack("HHH", state)[2]
    finally:
        os.close(fd)
    for vt in [front] + [n for n in range(1, 16) if in_use >> n & 1 and n != front]:
        try:
            fd = os.open(f"/dev/tty{vt}", os.O_RDONLY | os.O_NOCTTY)
        except OSError:
            continue
        mode = bytearray(4)
        try:
            fcntl.ioctl(fd, KDGKBMODE, mode)
            if struct.unpack("i", mode)[0] == K_UNICODE:
                return fd
        except OSError:
            pass
        os.close(fd)
    return None


class Keymap:
    """Void the copy and paste chords (VOIDED) in the console keymap (global to all
    VTs); restore the original entries on exit. Re-applied if something
    reloads the keymap (loadkeys, systemd-vconsole-setup).

    The original entries are written to KEYMAP_STATE before the first change
    and read back by the next instance: an instance that dies without
    restoring (SIGKILL, a crash) leaves the holes in the kernel, and the next
    one would otherwise take them for the originals and leave the chords dead
    for good. (tty-i3-keys does the same for its own keycodes, in its own
    file: the two never touch each other's entries.)"""

    def __init__(self):
        # /dev/tty0 opens the console in front at that moment, and an open
        # console cannot be freed: open it only for each use, or a daemon
        # started while a lock's spare VT is in front would pin that VT.
        self.fd = None
        self.saved = self.load()    # (table, keycode) -> original entry
        self.no_unicode_vt = False

    def open_unicode_vt(self):
        fd = unicode_vt()
        if fd is None:
            if not self.no_unicode_vt:
                print("keymap: no VT in Unicode mode, keymap left alone until "
                      "there is one", flush=True)
            self.no_unicode_vt = True
        else:
            self.no_unicode_vt = False
        return fd

    @staticmethod
    def load():
        saved = {}
        try:
            with open(KEYMAP_STATE) as f:
                for line in f:
                    table, keycode, value = (int(x, 0) for x in line.split())
                    saved[table, keycode] = value
        except FileNotFoundError:
            return saved
        except (OSError, ValueError):
            traceback.print_exc()
            return saved
        print(f"keymap: {len(saved)} original entries left by an instance "
              "that did not restore them", flush=True)
        return saved

    def store(self):
        os.makedirs(os.path.dirname(KEYMAP_STATE), exist_ok=True)
        with open(KEYMAP_STATE + ".new", "w") as f:
            f.writelines(f"{t} {k} {v:#06x}\n"
                         for (t, k), v in sorted(self.saved.items()))
            f.flush()
            os.fsync(f.fileno())
        os.replace(KEYMAP_STATE + ".new", KEYMAP_STATE)

    def get(self, table, keycode):
        buf = bytearray(struct.pack("BBH", table, keycode, 0))
        fcntl.ioctl(self.fd, KDGKBENT, buf)
        return struct.unpack("BBH", buf)[2]

    def set(self, table, keycode, value):
        fcntl.ioctl(self.fd, KDSKBENT, struct.pack("BBH", table, keycode, value))

    def apply(self):
        self.fd = self.open_unicode_vt()
        if self.fd is None:
            return
        try:
            self._apply()
        finally:
            os.close(self.fd)
            self.fd = None

    def _apply(self):
        # A missing table reads as a hole for every keycode but 0, and the
        # chord then types nothing anyway: holes are left alone, which also
        # keeps a hole write from allocating a table.
        changes = []
        for table, keycode in VOIDED:
            value = self.get(table, keycode)
            if value != K_HOLE:
                # The original, or a reloaded keymap's: the one to keep.
                changes.append((table, keycode, value))
        if not changes:
            return
        for table, keycode, value in changes:
            self.saved[table, keycode] = value
        self.store()            # before the change: a crash leaves the record
        for table, keycode, _ in changes:
            self.set(table, keycode, K_HOLE)
        print(f"keymap: voided {len(changes)} entries: " + ", ".join(
            f"t{t}/k{k} {v:#06x}" for t, k, v in changes), flush=True)

    def restore(self):
        self.fd = self.open_unicode_vt()
        if self.fd is None:
            return
        try:
            failed = False
            for (table, keycode), value in self.saved.items():
                try:
                    self.set(table, keycode, value)
                except OSError:
                    traceback.print_exc()
                    failed = True
            print(f"keymap: restored {len(self.saved)} entries", flush=True)
            if not failed:
                try:
                    os.unlink(KEYMAP_STATE)
                except FileNotFoundError:
                    pass
        finally:
            os.close(self.fd)
            self.fd = None


class Console:
    """The foreground VT, reopened when it changes or gets hung up."""

    def __init__(self):
        self.name = None
        self.fd = None

    def close(self):
        if self.fd is not None:
            os.close(self.fd)
        self.fd = self.name = None

    def _query(self):
        with open("/sys/class/tty/tty0/active") as f:
            name = "/dev/" + f.read().strip()
        if name != self.name:
            self.close()
            self.fd = os.open(name, os.O_RDWR | os.O_NOCTTY)
            self.name = name
        mode = bytearray(4)
        fcntl.ioctl(self.fd, KDGETMODE, mode)
        if struct.unpack("i", mode)[0] != KD_TEXT:
            return None
        kbmode = bytearray(4)
        fcntl.ioctl(self.fd, KDGKBMODE, kbmode)
        if struct.unpack("i", kbmode)[0] not in (K_XLATE, K_UNICODE):
            return None
        return (self.fd, *size(self.fd), tioclinux_get(self.fd,
                                                      TIOCL_GETMOUSEREPORTING))

    def state(self):
        """(fd, cols, rows, mouse reporting mode) of the foreground VT if it
        is in text mode, else None. A new session on a VT calls vhangup(),
        which kills our cached fd (EIO): reopen and ask again."""
        try:
            return self._query()
        except OSError:
            self.close()
            return self._query()


def size(fd):
    rows, cols, _, _ = struct.unpack("4H", fcntl.ioctl(fd, TIOCGWINSZ, bytes(8)))
    return cols, rows


def tioclinux_get(fd, subcode):
    buf = bytearray([subcode])
    fcntl.ioctl(fd, TIOCLINUX, buf)
    return buf[0]


def setsel(fd, xs, ys, xe, ye, mode):
    fcntl.ioctl(fd, TIOCLINUX, struct.pack("<B5H", TIOCL_SETSEL,
                                           xs, ys, xe, ye, mode))


def inject(fd, data):
    for byte in data:
        fcntl.ioctl(fd, TIOCSTI, bytes([byte]))


# CONSOLE_MOUSE_DEBUG=1: log every xterm report sent to a program.
DEBUG_REPORTS = os.environ.get("CONSOLE_MOUSE_DEBUG") == "1"


# Per VT fd: the last report code sent, and the last button pressed.
LAST_REPORT = {}
LAST_PRESS = {}


def press(fd, code, col, row, mode):
    """A button press, preceded in VT200 mode by a motion report to the
    same cell. A graphical terminal reports the pointer moving there first;
    the console cannot (the kernel keeps no any-motion mode, DECSET 1003),
    and tmux picks a menu item by the last motion: without it, a click on an
    item of a menu that stays open ran nothing. Only for the click after a
    right click (the one that opened the menu) and its release: tmux reads a
    motion report as a move only when its previous event was a release
    (server_client_check_mouse); otherwise - after a wheel step, or in a
    program just started that never saw our release - it takes it for the
    start of a drag."""
    if (mode == 2 and LAST_REPORT.get(fd) == RELEASE
            and LAST_PRESS.get(fd) == BUTTON_CODE[BTN_RIGHT]):
        report(fd, MOTION | RELEASE, col, row)
    LAST_PRESS[fd] = code
    report(fd, code, col, row)


def report(fd, code, col, row):
    LAST_REPORT[fd] = code
    if DEBUG_REPORTS:
        log(f"report code {code} at {col},{row}")
    inject(fd, b"\033[M" + bytes([32 + code, 32 + min(col, XTERM_MAX_CELL),
                                  32 + min(row, XTERM_MAX_CELL)]))


def screen(console_name, cols, rows):
    """The characters of a VT, from /dev/vcsuN (one native-endian UTF-32 cell
    per character), or None if the read comes back short."""
    need = cols * rows * 4
    data = b""
    with open(console_name.replace("/dev/tty", "/dev/vcsu"), "rb") as f:
        while len(data) < need:
            chunk = f.read(need - len(data))
            if not chunk:
                return None
            data += chunk
    return list(data.decode(f"utf-32-{sys.byteorder[0]}e", errors="replace"))


# Characters that belong to a word for double-click selection: the kernel's
# default inwordLut (0-9 A-Z a-z - . / _) plus everything beyond ASCII.
WORD_CHARS = set("-./_0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                 "abcdefghijklmnopqrstuvwxyz")


def selected_text(chars, cols, start, end, mode):
    """The text the kernel highlights for a selection between two cells
    (0-based linear indices), with the kernel's word/line expansion and its
    trailing-blank stripping; line breaks are '\\r', as a paste sends them."""
    inword = lambda c: c in WORD_CHARS or ord(c) > 0x7F
    space = lambda i: chars[i] == " "
    atedge = lambda i: i % cols == 0 or (i + 1) % cols == 0
    if start > end:
        start, end = end, start
    if mode == SEL_WORD:
        spc = space(start)
        i = start
        while True:
            if (space(i) if spc else inword(chars[i])) is False:
                break
            start = i
            if i % cols == 0:
                break
            i -= 1
        spc = space(end)
        i = end
        while True:
            if (space(i) if spc else inword(chars[i])) is False:
                break
            end = i
            if (i + 1) % cols == 0:
                break
            i += 1
    elif mode == SEL_LINE:
        start -= start % cols
        end = end - end % cols + cols - 1
    if end > start and not atedge(end) and space(end):
        i = end + 1
        while space(i) and not atedge(i):
            i += 1
        if space(i):
            end = i
    out, kept = [], 0
    for i in range(start, end + 1):
        out.append(chars[i])
        if chars[i] != " ":
            kept = len(out)
        if (i + 1) % cols == 0:
            if kept != len(out):
                del out[kept:]
                out.append("\r")
            kept = len(out)
    return "".join(out)


# Sends nerd-dictation's own "toggle" command; its reply goes to the journal.
DICTATION_CLIENT = """
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(10)
try:
    s.connect(sys.argv[1])
    s.send(json.dumps({"action": "toggle"}).encode())
    print("middle click: nerd-dictation", s.recv(4096).decode(errors="replace"))
except OSError as e:
    print(f"middle click: nerd-dictation: {sys.argv[1]}: {e}")
"""


class Dictation:
    """Toggles the nerd-dictation daemon of the user who owns the console.
    The socket lives in a directory that user controls, so the client runs
    as that user, never as root, and only one request is in flight."""

    def __init__(self):
        self.child = None

    def toggle(self, uid):
        if uid == 0:
            return                  # login prompt or root console
        if self.child and self.child.poll() is None:
            log("middle click: previous nerd-dictation toggle still pending")
            return
        user = pwd.getpwuid(uid)
        self.child = subprocess.Popen(
            [sys.executable, "-c", DICTATION_CLIENT,
             DICTATION_SOCKET.format(uid=uid)],
            user=uid, group=user.pw_gid, extra_groups=[], env={},
            stdin=subprocess.DEVNULL, start_new_session=True)


class Pointer:
    def __init__(self):
        self.x = self.y = 1.0
        self.held = set()           # buttons held, as BTN_* codes
        self.anchor = (1, 1)
        self.sel_mode = SEL_CHAR
        self.last_click = (0.0, None)
        self.clicks = 0
        self.drawn = None
        self.shift = False          # Shift held at the latest pointer frame
        self.forwarded = set()      # buttons whose press went to the program
        self.vt = None              # VT of the latest pointer frame
        self.pending = None         # cell of a left press: click or drag?
        self.selection = ("", None)  # (text highlighted, VT it is on)
        self.selection_uid = None   # owner of that VT when it was selected
        # What to highlight again after the kernel dropped it:
        # (anchor, end cell, mode, cols, rows) on the VT of self.selection.
        self.highlight = None
        self.watch = None           # /dev/vcsaN of that VT: POLLPRI on update
        self.lit = None             # its attribute bytes while highlighted
        self.clipboard = ("", None)  # (text, uid owning the VT it came from)
        self.dictation = Dictation()

    def release_all(self):
        """Forget held buttons without reporting their release."""
        self.held.clear()
        self.forwarded.clear()
        self.pending = None

    def cell(self, cols, rows):
        self.x = min(max(self.x, 1.0), cols + 0.999)
        self.y = min(max(self.y, 1.0), rows + 0.999)
        return int(self.x), int(self.y)

    def select(self, con, cols, rows, col, row):
        fd, name = con
        setsel(fd, *self.anchor, col, row, self.sel_mode)
        text = self.text_at(name, cols, rows, self.anchor, (col, row),
                            self.sel_mode)
        self.selection = (text or "", name)
        self.selection_uid = os.stat(name).st_uid
        self.highlight = (self.anchor, (col, row), self.sel_mode, cols, rows)
        if self.watch is None or self.watch[1] != name:
            self.unwatch()
            try:
                self.watch = (os.open(name.replace("/dev/tty", "/dev/vcsa"),
                                      os.O_RDONLY), name)
            except OSError:         # no vcsa: the highlight is not kept
                traceback.print_exc()
                self.highlight = None
                return
        # The pointer is drawn at (col, row) next.
        self.lit = self.attrs((col, row))

    @staticmethod
    def text_at(name, cols, rows, start, end, mode):
        lin = lambda c, r: (r - 1) * cols + (c - 1)
        chars = screen(name, cols, rows)
        return chars and selected_text(chars, cols, lin(*start), lin(*end), mode)

    def unwatch(self):
        if self.watch:
            os.close(self.watch[0])
        self.watch = self.lit = None

    def attrs(self, pointer=None):
        """The attribute bytes of the selected cells (but the pointer's),
        from /dev/vcsaN; reading it also acknowledges the update."""
        start, end, _, cols, rows = self.highlight
        data = os.pread(self.watch[0], 4 + 2 * cols * rows, 0)
        lin = lambda c, r: (r - 1) * cols + (c - 1)
        first, last = sorted((lin(*start), lin(*end)))
        pointer = pointer or (self.drawn and self.drawn[1:])
        # A one-cell selection under the pointer is compared with it.
        skip = lin(*pointer) if pointer and first != last else -1
        return bytes(data[5 + 2 * i] for i in range(first, last + 1)
                     if i != skip and 5 + 2 * i < len(data))

    def refresh(self, state, name):
        """The selection's VT was updated (POLLPRI on its vcsa): highlight
        the selection again if the kernel dropped it. Any write to the
        console clears it (con_write -> hide_cursor -> clear_selection), and
        tmux writes all the time (status line, other panes). Only while the
        selected cells still show the selected text; once they change the
        highlight is gone for good, the copy keeps what was selected. Our
        own setsel and pointer updates wake us too: the attributes then are
        the highlighted ones and nothing is done."""
        text, vt = self.selection
        if vt != name:
            # Another VT in front: switching back clears the kernel's
            # selection anyway, and its updates need not wake us.
            self.highlight = None
            self.unwatch()
            return
        try:
            attrs = self.attrs()    # also acknowledges the update
        except OSError:             # VT deallocated
            self.highlight = None
            self.unwatch()
            return
        if (state is None or not self.highlight or not text or vt != name
                or self.held or attrs == self.lit):
            return
        fd, cols, rows, _ = state
        start, end, mode, c, r = self.highlight
        if (c, r) != (cols, rows) or self.text_at(
                name, cols, rows, start, end, mode) != text:
            self.highlight = None
            self.unwatch()
            return
        setsel(fd, *start, *end, mode)     # cleared: put it back
        if self.drawn and self.drawn[0] == fd:
            self.draw(*self.drawn)
        self.lit = self.attrs()

    def move(self, con, cols, rows, dcols, drows, mode):
        fd = con[0]
        before = self.cell(cols, rows)
        self.x += dcols
        self.y += drows
        col, row = self.cell(cols, rows)
        if (col, row) == before:
            if self.drawn != (fd, col, row):
                self.draw(fd, col, row)
            return
        if mode == 2 and self.forwarded:
            report(fd, 32 + BUTTON_CODE[min(self.forwarded)], col, row)
        if BTN_LEFT in self.held and BTN_LEFT not in self.forwarded:
            self.pending = None         # a drag: the console's selection
            self.select(con, cols, rows, col, row)
        self.draw(fd, col, row)

    def draw(self, fd, col, row):
        setsel(fd, col, row, col, row, SEL_POINTER)
        self.drawn = (fd, col, row)

    def button(self, con, cols, rows, btn, pressed, mode):
        fd, name = con
        col, row = self.cell(cols, rows)
        if pressed:
            self.held.add(btn)
        else:
            self.held.discard(btn)
        if btn == BTN_MIDDLE:
            if pressed:
                self.dictation.toggle(os.stat(name).st_uid)
            return
        # The program gets the right button, and the left one with Shift;
        # otherwise the left button selects, and only a click that did not
        # move (decided on release) goes to the program.
        if pressed and mode and (btn != BTN_LEFT or self.shift):
            self.forwarded.add(btn)
            press(fd, BUTTON_CODE[btn], col, row, mode)
            return
        if not pressed:
            if btn in self.forwarded:
                self.forwarded.discard(btn)
                if mode == 2:
                    report(fd, RELEASE, col, row)
            elif btn == BTN_LEFT and self.pending:
                if mode:
                    press(fd, BUTTON_CODE[BTN_LEFT], *self.pending, mode)
                    if mode == 2:
                        report(fd, RELEASE, *self.pending)
                self.pending = None
            return
        if btn == BTN_LEFT:
            now = time.monotonic()
            last_time, last_cell = self.last_click
            if now - last_time < MULTI_CLICK_SECONDS and last_cell == (col, row):
                self.clicks = self.clicks % 3 + 1
            else:
                self.clicks = 1
            self.last_click = (now, (col, row))
            self.sel_mode = (SEL_CHAR, SEL_WORD, SEL_LINE)[self.clicks - 1]
            self.anchor = (col, row)
            if self.clicks > 1:
                self.pending = None
                self.select(con, cols, rows, col, row)
            else:
                self.pending = (col, row) if mode else None
                setsel(fd, col, row, col, row, SEL_CLEAR)
                self.selection = ("", None)
                self.highlight = None
                self.unwatch()
        elif btn == BTN_RIGHT and self.selection[1] == name:
            self.select(con, cols, rows, col, row)

    def scroll(self, con, cols, rows, steps, mode):
        if mode != 2:
            return
        col, row = self.cell(cols, rows)
        code = WHEEL_UP if steps > 0 else WHEEL_DOWN
        for _ in range(abs(steps)):
            report(con[0], code, col, row)

    def copy(self, name):
        text, vt = self.selection
        uid = os.stat(name).st_uid
        # Not a selection a previous user of this VT left behind.
        if not text:
            log(f"copy on {name}: nothing selected")
        elif vt != name:
            log(f"copy on {name}: the selection is on {vt}")
        elif uid != self.selection_uid:
            log(f"copy on {name}: selected by uid {self.selection_uid}, "
                f"the console is now uid {uid}")
        else:
            self.clipboard = (text, uid)
            log(f"copied {len(text)} characters")

    def paste(self, fd, name):
        """Paste only into a console of the user the text was copied from:
        the daemon types as root into whatever VT is in front."""
        text, uid = self.clipboard
        if not text:
            log(f"paste on {name}: nothing copied")
            return
        if os.stat(name).st_uid != uid:
            log(f"paste on {name}: copied by uid {uid}, the console is "
                f"uid {os.stat(name).st_uid}")
            return
        try:
            # Unlike the other getters, this one is the ioctl's return value.
            bracketed = fcntl.ioctl(fd, TIOCLINUX,
                                    bytearray([TIOCL_GETBRACKETEDPASTE]))
        except OSError:             # older kernel: no bracketed paste
            bracketed = 0
        data = text.encode()
        if bracketed:
            data = b"\033[200~" + data + b"\033[201~"
        inject(fd, data)
        log(f"pasted {len(text)} characters on {name}"
            + (" (bracketed)" if bracketed else ""))


def in_right_area(dev):
    """Is a finger on the clickpad's right software button?"""
    if dev.right_area is None:
        return False
    top, left = dev.right_area
    points = [p for s in dev.contacts if None not in (p := dev.slot_pos.get(s, [None, None]))]
    if not points and dev.abs_x is not None:
        points = [(dev.abs_x, dev.abs_y)]
    return any(x >= left and y >= top for x, y in points)


def finger_count(dev, code, value):
    counts = {BTN_TOOL_FINGER: 1, BTN_TOOL_DOUBLETAP: 2,
              BTN_TOOL_TRIPLETAP: 3, BTN_TOOL_QUADTAP: 4}
    if value:
        dev.fingers = counts[code]
        dev.tap_fingers = max(dev.tap_fingers, dev.fingers)
    elif dev.fingers == counts[code]:
        dev.fingers = 0
    dev.last_x = dev.last_y = None  # no jump when the finger count changes


def take_steps(dev, amount, per_step):
    """Accumulate scroll distance; return whole wheel steps (+ = up)."""
    dev.scroll_acc += amount
    steps = int(dev.scroll_acc / per_step)
    dev.scroll_acc -= steps * per_step
    return -steps   # moving down scrolls down, which is the wheel's "down"


def console_rotation():
    """The foreground console's rotation in quarter turns clockwise."""
    try:
        with open("/sys/class/graphics/fbcon/rotate") as f:
            return int(f.read().strip()) % 4
    except (OSError, ValueError):
        return 0


class Daemon:
    def __init__(self):
        self.devices = {}
        self.pointer = Pointer()
        self.console = Console()
        self.keymap = Keymap()
        self.keys_held = set()      # keyboard keys held, all keyboards

    def frame(self, dev):
        """Apply one SYN_REPORT worth of pointer events from one device."""
        state = self.console.state()
        if state is None:           # X: buttons pressed there are not ours
            self.pointer.release_all()
            dev.reset_frame()
            return
        fd, cols, rows, mode = state
        if self.console.name != self.pointer.vt:
            # Buttons pressed on another VT are not this one's to release.
            self.pointer.release_all()
            self.pointer.vt = self.console.name
        self.pointer.shift = bool(self.keys_held & SHIFT)
        con = (fd, self.console.name)
        pointer = self.pointer

        if dev.pointer == "touchscreen":
            self.touchscreen(dev, con, cols, rows, mode)
            dev.reset_frame()
            return

        dcols = drows = 0.0
        steps = dev.wheel
        if dev.pointer == "touchpad" and dev.pressed_as:
            # The clickpad is held down. Like libinput: the finger that
            # pressed rests while another one drags, and the pointer follows
            # whichever contact moves - never scrolling, so a press-and-drag
            # selects. (ABS_X follows the first contact, the resting one.)
            # A finger in the bottom button strip is the one pressing: as in
            # libinput it does not move the pointer, so the jitter of a
            # press does not turn a click into a drag (a right click that
            # drifted a cell was taken by tmux as a drag over its menu and
            # the release picked an item).
            top = dev.right_area[0] if dev.right_area else None
            best = None
            for slot in dev.contacts:
                cur, prev = dev.slot_pos.get(slot), dev.slot_prev.get(slot)
                if top is not None and cur and cur[1] is not None and cur[1] >= top:
                    continue
                if cur and prev and None not in cur and None not in prev:
                    mm_x = (cur[0] - prev[0]) / dev.res_x
                    mm_y = (cur[1] - prev[1]) / dev.res_y
                    if best is None or math.hypot(mm_x, mm_y) > math.hypot(*best):
                        best = (mm_x, mm_y)
            if best:
                dev.tap_travel += math.hypot(*best)
                dcols, drows = best[0] * TP_COLS_PER_MM, best[1] * TP_ROWS_PER_MM
            dev.last_x, dev.last_y = dev.abs_x, dev.abs_y
            dev.scroll_acc = 0.0
        elif dev.pointer == "touchpad":
            if dev.touching and dev.abs_x is not None and dev.last_x is not None:
                mm_x = (dev.abs_x - dev.last_x) / dev.res_x
                mm_y = (dev.abs_y - dev.last_y) / dev.res_y
                dev.tap_travel += math.hypot(mm_x, mm_y)
                if dev.fingers >= 2:
                    steps += take_steps(dev, mm_y, TP_SCROLL_MM)
                elif dev.fingers == 1:
                    dcols, drows = mm_x * TP_COLS_PER_MM, mm_y * TP_ROWS_PER_MM
            if dev.touching:
                dev.last_x, dev.last_y = dev.abs_x, dev.abs_y
            else:
                dev.last_x = dev.last_y = None
                dev.scroll_acc = 0.0
        elif dev.middle_down:
            if dev.dx or dev.dy:
                dev.middle_moved = True
            steps += take_steps(dev, dev.dy, REL_SCROLL_COUNTS)
        else:
            dcols = dev.dx * REL_COLS_PER_COUNT
            drows = dev.dy * REL_ROWS_PER_COUNT

        if dcols or drows:
            pointer.move(con, cols, rows, dcols, drows, mode)
        if steps:
            pointer.scroll(con, cols, rows, steps, mode)
        for btn, pressed in dev.keys:
            pointer.button(con, cols, rows, btn, pressed, mode)
        if dev.pointer == "touchpad":
            dev.slot_prev = {s: list(dev.slot_pos[s]) for s in dev.contacts
                             if s in dev.slot_pos}
        dev.reset_frame()

    def touchscreen(self, dev, con, cols, rows, mode):
        """Turn the contacts of one frame into taps, a left-button drag or
        two-finger scrolling."""
        pointer = self.pointer
        (x0, x1), (y0, y1) = dev.ranges
        quarter = console_rotation()

        def cell(xy):
            # Panel position as fractions, then turned the way the console
            # is (fbcon rotate: quarter turns clockwise).
            u = (xy[0] - x0) / (x1 - x0 + 1)
            v = (xy[1] - y0) / (y1 - y0 + 1)
            cx, cy = ((u, v), (v, 1 - u), (1 - u, 1 - v), (1 - v, u))[quarter]
            return 1 + cx * cols, 1 + cy * rows

        def goto(col, row):
            pointer.move(con, cols, rows, col - pointer.x, row - pointer.y, mode)

        points = [cell(dev.slot_pos[s]) for s in sorted(dev.contacts)
                  if None not in dev.slot_pos.get(s, (None,))]
        g = dev.gesture
        now = time.monotonic()
        if points and g is None:
            g = dev.gesture = {"t0": now, "start": points[0], "most": 0,
                               "moved": False, "drag": False, "acc": 0.0,
                               "last_y": None}
        if g is None:
            return
        g["most"] = max(g["most"], len(points))

        if len(points) == 1 and g["most"] == 1:
            col, row = points[0]
            sc, sr = g["start"]
            if abs(col - sc) > TS_TAP_CELLS or abs(row - sr) > TS_TAP_CELLS:
                g["moved"] = True
            if g["moved"]:
                if not g["drag"]:
                    goto(sc, sr)
                    pointer.button(con, cols, rows, BTN_LEFT, True, mode)
                    g["drag"] = True
                goto(col, row)
        elif len(points) >= 2:
            if g["drag"]:
                pointer.button(con, cols, rows, BTN_LEFT, False, mode)
                g["drag"] = False
            avg = sum(r for _, r in points) / len(points)
            if g["last_y"] is not None:
                # The content follows the fingers: moving them down shows
                # earlier lines, which is the wheel's "up".
                g["acc"] += avg - g["last_y"]
                steps = int(g["acc"] / TS_SCROLL_ROWS)
                if steps:
                    g["acc"] -= steps * TS_SCROLL_ROWS
                    g["moved"] = True
                    pointer.scroll(con, cols, rows, steps, mode)
            g["last_y"] = avg
        elif not points:
            if g["drag"]:
                pointer.button(con, cols, rows, BTN_LEFT, False, mode)
            elif not g["moved"] and now - g["t0"] < TS_TAP_SECONDS:
                btn = {1: BTN_LEFT, 2: BTN_RIGHT}.get(g["most"])
                if btn:
                    if btn == BTN_LEFT:
                        goto(*g["start"])
                    pointer.button(con, cols, rows, btn, True, mode)
                    pointer.button(con, cols, rows, btn, False, mode)
            dev.gesture = None

    def key(self, code, value):
        if value == 0:
            self.keys_held.discard(code)
            return
        self.keys_held.add(code)
        if value != 1 or code not in (KEY_C, KEY_V, KEY_INSERT):
            return
        held = self.keys_held
        ctrl, shift, alt = held & CTRL, held & SHIFT, KEY_LEFTALT in held
        if code == KEY_INSERT:
            if alt or bool(ctrl) == bool(shift):
                return
            copy = bool(ctrl)       # Ctrl+Insert copies, Shift+Insert pastes
        elif (ctrl and shift and not alt) or (alt and not shift):
            # Ctrl+Shift, Alt or Ctrl+Alt: the voided chords
            copy = code == KEY_C
        else:
            if ctrl or alt:
                log(f"not a copy/paste chord: keys held {sorted(held)}")
            return
        state = self.console.state()
        if state is None:
            log(f"{'copy' if copy else 'paste'}: {self.console.name} is not a "
                "text console with a character keyboard (X, or a screen lock)")
            return
        if copy:
            self.pointer.copy(self.console.name)
        else:
            self.pointer.paste(state[0], self.console.name)

    def touch(self, dev, down):
        """BTN_TOUCH: start a touch, or end it and turn it into a tap."""
        dev.touching = down
        now = time.monotonic()
        if down:
            dev.touch_start = now
            return
        tap = {1: BTN_LEFT, 2: BTN_RIGHT}.get(dev.tap_fingers)
        if (tap and not dev.tap_clicked and now - dev.touch_start < TAP_SECONDS
                and dev.tap_travel < TAP_MAX_MM):
            dev.keys += [(tap, True), (tap, False)]
        dev.tap_fingers, dev.tap_travel, dev.tap_clicked = 0, 0.0, False

    def handle(self, dev, type_, code, value):
        if type_ == EV_SYN and code == SYN_REPORT:
            if dev.pointer:
                self.frame(dev)
        elif type_ == EV_REL:
            if code == REL_X:
                dev.dx += value
            elif code == REL_Y:
                dev.dy += value
            elif code == REL_WHEEL:
                dev.wheel += value
        elif type_ == EV_ABS and dev.pointer == "touchscreen":
            if code == ABS_MT_SLOT:
                dev.slot = value
            elif code == ABS_MT_TRACKING_ID:
                if value < 0:
                    dev.contacts.discard(dev.slot)
                else:
                    dev.contacts.add(dev.slot)
            elif code in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                pos = dev.slot_pos.setdefault(dev.slot, [None, None])
                pos[code - ABS_MT_POSITION_X] = value
        elif type_ == EV_ABS and dev.pointer == "touchpad" and code in (
                ABS_MT_SLOT, ABS_MT_TRACKING_ID, ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
            if code == ABS_MT_SLOT:
                dev.slot = value
            elif code == ABS_MT_TRACKING_ID:
                if value < 0:
                    dev.contacts.discard(dev.slot)
                    dev.slot_prev.pop(dev.slot, None)
                else:
                    dev.contacts.add(dev.slot)
            else:
                pos = dev.slot_pos.setdefault(dev.slot, [None, None])
                pos[code - ABS_MT_POSITION_X] = value
        elif type_ == EV_ABS:
            if code == ABS_X:
                dev.abs_x = value
            elif code == ABS_Y:
                dev.abs_y = value
        elif type_ == EV_KEY and dev.pointer == "touchscreen":
            pass                    # BTN_TOUCH: the MT contacts say it all
        elif type_ == EV_KEY:
            if dev.pointer and code == BTN_TOUCH:
                self.touch(dev, bool(value))
            elif dev.pointer and (code == BTN_TOOL_FINGER
                                  or BTN_TOOL_DOUBLETAP <= code <= BTN_TOOL_QUADTAP):
                finger_count(dev, code, value)
            elif dev.pointer and code in BUTTON_CODE and value != 2:
                btn = code
                if dev.pointer == "touchpad":
                    dev.tap_clicked = True
                    # How many fingers touch does not matter (on a clickpad
                    # one rests while another moves, and taking two fingers
                    # for a right click opened tmux's menu on a left press):
                    # where the press is does. A finger in the right half of
                    # the bottom strip makes it the right button.
                    if value and code == BTN_LEFT and in_right_area(dev):
                        btn = BTN_RIGHT
                # Release what the press acted as, even if fingers changed.
                if value:
                    dev.pressed_as[code] = btn
                else:
                    btn = dev.pressed_as.pop(code, btn)
                if code == BTN_MIDDLE:
                    # Middle button scrolls while moved; a still click acts.
                    if value:
                        dev.middle_down, dev.middle_moved = True, False
                        dev.scroll_acc = 0.0
                        return
                    dev.middle_down = False
                    if dev.middle_moved:
                        return
                    dev.keys.append((btn, True))
                dev.keys.append((btn, bool(value)))
            elif dev.keyboard:
                self.key(code, value)

    def scan(self):
        known = {d.path for d in self.devices.values()}
        for path in sorted(glob.glob("/dev/input/event*")):
            if path not in known:
                dev = probe(path)
                if dev:
                    self.devices[dev.fd] = dev
        self.keymap.apply()

    def remove(self, dev):
        """Device gone: forget it and anything it was holding down."""
        os.close(dev.fd)
        del self.devices[dev.fd]
        if dev.pointer:
            self.pointer.release_all()
        if dev.keyboard:
            self.keys_held.clear()

    def run(self):
        next_scan = 0.0
        while True:
            if time.monotonic() >= next_scan:
                try:
                    self.scan()
                except Exception:
                    traceback.print_exc()
                next_scan = time.monotonic() + RESCAN_SECONDS
            watch = self.pointer.watch
            ready, _, updated = select.select(
                list(self.devices), [], [watch[0]] if watch else [],
                RESCAN_SECONDS)
            if updated:
                try:
                    self.pointer.refresh(self.console.state(),
                                         self.console.name)
                except OSError:
                    self.console.close()
            for fd in ready:
                dev = self.devices[fd]
                try:
                    data = os.read(fd, EVENT.size * 64)
                except BlockingIOError:
                    continue
                except OSError:         # unplugged
                    data = b""
                if not data:
                    self.remove(dev)
                    continue
                for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
                    _, _, type_, code, value = EVENT.unpack_from(data, i)
                    try:
                        self.handle(dev, type_, code, value)
                    except Exception as e:
                        # One bad frame must not take the console mouse (and
                        # the voided keymap entries) down with it.
                        if not isinstance(e, OSError):  # OSError: VT vanished
                            traceback.print_exc()
                        self.console.close()
                        dev.reset_frame()


def main():
    daemon = Daemon()
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(0))
    try:
        daemon.run()
    finally:
        daemon.keymap.restore()


if __name__ == "__main__":
    main()
